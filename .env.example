# ==========================================
# MENTRA ENVIRONMENT VARIABLES & API KEYS
# ==========================================

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/mentra

# Groq API Key
GROQ_API_KEY=your_groq_api_key

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# JWT Secret (REQUIRED — app will not start without this)
JWT_SECRET=your_jwt_secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Email SMTP (for OTP / password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Mentra <noreply@mentra.app>

